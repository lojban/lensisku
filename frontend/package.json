{
  "name": "vue-ssg-i18n-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:watch": "vue-tsc --noEmit -p tsconfig.app.json --watch",
    "typecheck:pretty": "vue-tsc --noEmit -p tsconfig.app.json --pretty",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite-ssg build",
    "preview": "vite preview",
    "start": "vue-tsc --noEmit -p tsconfig.app.json && vite-ssg build && pnpm preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-config-hints",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm knip && pnpm run i18n:check",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@milkdown/core": "^7.21.3",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/utils": "^7.21.3",
    "@paypal/paypal-js": "^10.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-virtual": "^3.13.34",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.18.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "jwt-decode": "4.0.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.7",
    "mathjax": "^4.1.3",
    "socket.io-client": "^4.8.3",
    "turndown": "^7.2.4",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  }
}
